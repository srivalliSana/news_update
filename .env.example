PORT=3000

# Slack — verify incoming requests (Slack App → Basic Information → Signing Secret)
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Slack — bot token, needed to auto-publish channel messages and download photos
# (Slack App → OAuth & Permissions → Bot User OAuth Token, starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Optional: only ingest messages from this channel ID (blank = any channel the bot is in)
# Comma-separate for multiple channels, e.g. C0123,C0456
SLACK_CHANNEL=

# Optional: ignore posts from these people (member IDs or names, comma-separated)
# Member ID is most reliable (Slack profile → ⋮ → Copy member ID), e.g. U0123ABCD
# Names (e.g. "DN Rao") only work if the bot has the users:read scope.
SLACK_IGNORE_USERS=
